# Modelo seguro para versionamento; não substitua por credenciais reais.
# A Vercel não carrega este arquivo automaticamente: cadastre os valores em
# Project Settings > Environment Variables. Nunca use o prefixo VITE_ em segredos.
# Endpoint pooled do Neon (host com -pooler).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require"
# Endpoint direto do mesmo banco, usado para aplicar migrações.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
CLIENT_ORIGIN="https://SEU-PROJETO.vercel.app"
ADMIN_EMAIL="consultora@example.com"
ADMIN_PASSWORD="SUBSTITUA-POR-UMA-SENHA-EXCLUSIVA"
# Gere um segredo aleatório com pelo menos 32 caracteres.
JWT_SECRET="SUBSTITUA-POR-UM-SEGREDO-ALEATORIO-DE-PELO-MENOS-32-CARACTERES"
NODE_ENV="production"
